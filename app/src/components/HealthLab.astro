---
// Section 05 — 大健康实验室
const directions = [
  {
    name: 'AI for Biology',
    desc: '探索人工智能在生命科学中的应用：蛋白质结构、药物发现、组学数据分析。',
    icon: 'M12 3v18M5.5 6.5c4 3 9 3 13 0M5.5 17.5c4-3 9-3 13 0M8 3v3M16 3v3M8 18v3M16 18v3',
  },
  {
    name: 'Digital Health',
    desc: '探索数字化健康管理与个性化健康服务，让数据真正服务于日常。',
    icon: 'M3 12h4l2.5-6 4 12L16 12h5',
  },
  {
    name: 'AI-Native Research',
    desc: '尝试用 AI 工具提高学习、研究与开发效率——这个网站本身就是案例。',
    icon: 'M9.5 3 8 8.5 2.5 10 8 11.5 9.5 17 11 11.5 16.5 10 11 8.5 9.5 3ZM18 14l-1 3.5L13.5 18.5 17 19.5 18 23l1-3.5 3.5-1L19 17.5 18 14Z',
  },
];
---

<section id="health" class="border-t border-line">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-24 sm:py-32">
    <p class="section-label reveal">05 / Health Lab — 大健康实验室</p>
    <h2
      class="reveal reveal-d1 mt-8 text-3xl sm:text-5xl font-extrabold tracking-tight max-w-3xl"
    >
      从财富自由，<br />到<span class="text-accent">健康自由。</span>
    </h2>
    <p class="reveal reveal-d2 mt-6 text-dim text-lg max-w-2xl leading-relaxed">
      赚钱很重要，健康也很重要。这是实验室未来持续关注的四个研究方向——现在只是选题，但选题已经开始了。
    </p>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        directions.map((d, i) => (
          <div class={`card reveal reveal-d${(i % 2) + 1} p-8 relative overflow-hidden group`}>
            <div class="card-glow"></div>
            <svg
              viewBox="0 0 24 24"
              class="w-9 h-9 text-accent transition-transform duration-500 group-hover:scale-125 group-hover:rotate-12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={d.icon} />
            </svg>
            <h3 class="mt-5 text-xl font-bold tracking-tight font-mono">
              {d.name}
            </h3>
            <p class="mt-3 text-dim leading-relaxed">{d.desc}</p>
          </div>
        ))
      }
    </div>

    <p class="reveal mt-10 font-mono text-xs text-faint leading-relaxed border border-line rounded-xl px-5 py-4 bg-card/50 max-w-3xl">
      NOTE / 本栏目为探索性项目，仅记录学习方向，不提供任何诊断、治疗或个性化医疗建议。
    </p>
  </div>
</section>
